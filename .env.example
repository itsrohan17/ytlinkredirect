# Server Configuration
PORT=3000
NODE_ENV=development

# Optional Canonical Origin (set in Production to your deployed domain, e.g. https://your-app.vercel.app)
# BASE_URL=https://your-domain.vercel.app

# Production Database (Turso Cloud SQLite - Required for persistent storage on Vercel)
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# REQUIRED IN PRODUCTION / VERCEL: Dedicated Session Signing Secret (min 32 random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=replace-with-at-least-32-character-random-hex-secret
# Optional zero-downtime key rotation fallback during rollover:
# SESSION_SECRET_PREVIOUS=previous-session-secret-during-rotation-window

# AI YouTube Thumbnail Generator (NVIDIA FLUX NIM API)
# Get a key from https://build.nvidia.com/black-forest-labs/flux_1-dev
# Never commit or expose NVIDIA_API_KEY in frontend code or Git.
# NVIDIA_API_KEY=nvapi-your-secret-key
# NVIDIA_NIM_MODEL=black-forest-labs/flux.1-dev
# Optional base URL override (defaults to https://ai.api.nvidia.com/v1/genai)
# NVIDIA_NIM_BASE_URL=https://ai.api.nvidia.com/v1/genai
