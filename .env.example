# Server Configuration
PORT=3000
NODE_ENV=development

# Optional Base URL override (e.g. https://your-app.vercel.app)
# If not provided on Vercel, the app automatically detects the host header / x-forwarded-proto
# BASE_URL=https://your-domain.vercel.app

# Production Database (Required for persistent storage on Vercel / Serverless)
# We support Turso (Serverless Cloud SQLite) or any libSQL/SQLite over HTTP endpoint.
# Free Turso database setup (5 mins): https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
