# Server Configuration
PORT=3000
NODE_ENV=development

# Optional Base URL override (e.g. https://your-app.vercel.app)
# BASE_URL=https://your-domain.vercel.app

# Production Database (Turso Cloud SQLite - Required for persistent storage on Vercel)
# Free tier: 500 databases, 9 GB storage (https://turso.tech)
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# REQUIRED IN PRODUCTION / VERCEL: Dedicated Session Signing Secret (min 32 random chars)
# Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-at-least-32-character-random-hex-secret
# Optional zero-downtime key rotation fallback during SESSION_SECRET rollover:
# SESSION_SECRET_PREVIOUS=previous-session-secret-during-rotation-window

# ==============================================================================
# OPTIONAL: Private Object Storage & Background Worker (for >100 MB media jobs)
# Browser WASM & Canvas processing work at $0 without configuring these.
# ==============================================================================
# S3_BUCKET=your-private-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# STORAGE_TOKEN_SECRET=random-32-byte-secret-for-job-ownership-tokens

# Retention & Limits
# MAX_BROWSER_MB=100
# MAX_WORKER_MB=500
# FILE_TTL_HOURS=24
# SIGNED_URL_TTL_SECONDS=600

# Standalone Background Worker (run separately from Vercel: npm run worker)
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_JOB_TIMEOUT_MS=120000
# WORKER_MAX_RETRIES=2
# FFMPEG_PATH=ffmpeg
# CRON_SECRET=optional-bearer-token-for-cleanup-endpoint
