{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-client",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|robots\\.txt|index\\.html|api/)[a-zA-Z0-9_\\-]+)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
